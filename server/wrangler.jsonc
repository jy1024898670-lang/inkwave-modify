{
  // INKWAVE online relay: one Durable Object per room code (WebSocket fan-out + membership + host election).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inkwave-net",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }],
  "observability": { "enabled": false }
}
